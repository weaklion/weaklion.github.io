{
  "name": "weaklion-blog",
  "version": "1.0.0",
  "description": "WeakLion의 개발 기술 블로그",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-search-index.js",
